# Files excluded from the EAS Build upload archive.
# NOTE: when this file exists, EAS uses it INSTEAD of .gitignore for the
# archive, so every exclusion must be repeated here explicitly.

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native (regenerated by prebuild on EAS)
/ios
/android
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug / logs
npm-debug.*
yarn-debug.*
yarn-error.*
expo-server.log
expo-server.err.log
expo_start.log
tsc_out.txt

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

example

# Not needed by the build
docs/
*.md
!README.md
