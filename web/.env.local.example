# Local development environment for the Next.js web app.
#
# Production values live in Vercel, not here. The full inventory -- every
# variable, who owns it, and how to verify it -- is in PRODUCTION_CONFIG.md at
# the repo root. When you add a variable here, add it there too.
#
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time, so
# changing one needs a rebuild, not a restart.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Validated at build time by scripts/check-env.js -- a wrong value fails
# `npm run build` rather than surfacing when a user opens a page.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Bypasses RLS -- never expose this to the client, and never
# prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ───────────────────────────────────────────────────────────────────
# Use test-mode keys locally. Everything is currently test mode; see
# PRODUCTION_CONFIG.md gap G1 before changing that.
STRIPE_SECRET_KEY=sk_test_...

# From `stripe listen` locally, or the endpoint's signing secret in the Stripe
# dashboard. Without it the webhook route rejects every delivery.
STRIPE_WEBHOOK_SECRET=whsec_...

# ── App identity ─────────────────────────────────────────────────────────────
# Used for legal-page URLs and Stripe Connect return URLs. Defaults to
# https://pickleballapp.app when unset, which is wrong locally.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Apple Developer team id, served in the Universal Links AASA file. Without it
# the route serves a placeholder and Universal Links stop working.
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID

# ── Dev-only tooling ─────────────────────────────────────────────────────────
# Gates /api/dev/* (payment simulation, test fixtures). Those routes also hard
# 404 when NODE_ENV=production, but this MUST be left unset in production
# regardless -- it is the second of the two locks on a route that can mark a
# payment succeeded without Stripe.
# DEV_TOOLS_SECRET=
